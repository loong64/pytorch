+	bool l3_id_valid;
+	uint32_t l3_size;
+	uint32_t l3_associativity;
+	uint32_t l3_sets;
+	uint32_t l3_line_size;
+	uint32_t l3_partitions;
+	bool l3_geometry_valid;
+
+	/** Linux processor ID */
